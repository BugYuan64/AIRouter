# 容器部署环境变量。复制为 .env 并填写真实值，权限设为 600。
# .env 已被 .gitignore 忽略，不得提交。

# PostgreSQL 密码。建议 32 位以上随机串。
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 管理面密钥。与客户端网关 Key、CPA 数据面 Key 三者互不复用。
AIROUTER_ADMIN_KEY=replace-with-a-long-random-admin-key

# CPA 数据面 Key。从 CPA 服务器读取，或在 CPA 管理面板中新建一个专用客户端 Key。
# 不要与上面的 AIROUTER_ADMIN_KEY 相同。
CPA_API_KEY=replace-with-cpa-data-plane-key
