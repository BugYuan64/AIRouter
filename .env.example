# Example only. The executable reads process environment; it does not load this file.
AIROUTER_LISTEN_ADDR=127.0.0.1:8080
CPA_BASE_URL=http://127.0.0.1:8317
CPA_API_KEY=replace-with-cpa-client-key
AIROUTER_CLIENTS_FILE=clients.json
AIROUTER_UPSTREAM_TIMEOUT=10s
AIROUTER_REQUEST_TIMEOUT=10m
AIROUTER_MAX_REQUEST_BYTES=16777216
# 管理面：独立端口，未设置则不启用。不得与数据面同址。
# AIROUTER_ADMIN_ADDR=127.0.0.1:8081
